{
  "expo": {
    "name": "Nitya Gita",
    "slug": "nitya-gita",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nityagita",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.nityagita.app",
      "supportsTablet": false,
      "icon": "./assets/expo.icon",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.nityagita.app",
          "group.com.nityagita.app"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFF4E3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF9F0",
          "dark": {
            "backgroundColor": "#070B19"
          },
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-notifications",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.nityagita.app",
          "widgets": [
            {
              "name": "NityaGitaWidget",
              "displayName": "Nitya Gita",
              "description": "Daily Bhagavad Gita shlokas for your Lock Screen and Home Screen.",
              "ios": {
                "supportedFamilies": [
                  "accessoryRectangular",
                  "accessoryInline",
                  "systemSmall",
                  "systemMedium"
                ],
                "initialLayout": "./src/widgets/GitaShlokaWidget.tsx"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.nityagita.app.ExpoWidgetsTarget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.nityagita.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "cae18c3f-977d-4bdf-906c-c91bef839054"
      }
    }
  }
}
